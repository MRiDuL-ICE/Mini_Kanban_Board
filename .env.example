# Supabase PostgreSQL
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler string for serverless, "Session" for long-lived processes
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# Ports
BACKEND_PORT=4000
FRONTEND_PORT=3000

# URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"